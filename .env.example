# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN RONG NHO NHA TRANG (MẪU)
# Copy file này thành .env và điền các thông số thực tế

# Resend Email Marketing API Key (lấy tại https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=hi@rongnhonhatrang.vn
RESEND_FROM_NAME=Phương Trần - Rong Nho Nha Trang

# Sepay API Configuration (lấy tại https://my.sepay.vn)
SEPAY_API_TOKEN=your_sepay_api_token_here
SEPAY_BANK_SHORTCODE=MB
SEPAY_BANK_ACCOUNT=0933951409
SEPAY_ACCOUNT_HOLDER=TRAN THI PHUONG

# Server Port (khi chạy local)
PORT=5000
